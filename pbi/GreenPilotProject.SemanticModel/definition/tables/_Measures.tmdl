	measure 'PO Commitment Exposure RAG' =
			VAR OpenPO = [PO Open Commitment NOK]
			VAR TotalPO = [PO Amount NOK]
			VAR Rate = DIVIDE ( OpenPO, TotalPO, 0 )
			VAR IsVendorScope = ISINSCOPE ( Dim_Vendor[vendor_name] )
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( OpenPO ), BLANK (),
			    IsVendorScope && ( OpenPO >= 1500000 || Rate >= 0.60 ), "🔴 High Exposure (" & FORMAT ( OpenPO / 1e6, "0.00" ) & "M)",
			    IsVendorScope && ( OpenPO >= 500000 || Rate >= 0.35 ), "🟡 Moderate Exposure (" & FORMAT ( OpenPO / 1e6, "0.00" ) & "M)",
			    IsVendorScope, "🟢 Controlled Exposure (" & FORMAT ( OpenPO / 1e6, "0.00" ) & "M)",
			    OpenPO > 25000000, "🔴 High Exposure (>25M)",
			    OpenPO > 10000000, "🟡 Moderate Exposure (10-25M)",
			    "🟢 Controlled Exposure (<10M)"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: fd6e8b62-559c-4f15-8d54-1c31611d0c70

	measure 'PO Commitment Color RAG' =
			VAR OpenPO = [PO Open Commitment NOK]
			VAR TotalPO = [PO Amount NOK]
			VAR Rate = DIVIDE ( OpenPO, TotalPO, 0 )
			VAR IsVendorScope = ISINSCOPE ( Dim_Vendor[vendor_name] )
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( OpenPO ), BLANK (),
			    IsVendorScope && ( OpenPO >= 1500000 || Rate >= 0.60 ), "#BE123C",
			    IsVendorScope && ( OpenPO >= 500000 || Rate >= 0.35 ), "#D97706",
			    IsVendorScope, "#15803D",
			    OpenPO > 25000000, "#BE123C",
			    OpenPO > 10000000, "#D97706",
			    "#15803D"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: e439978c-3dda-45d9-8088-d8e6d092c4f6

	measure 'AuC Capitalization Rate RAG' =
			VAR Rate = [Capitalization Rate %]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( Rate ), BLANK (),
			    Rate > 0.80, "🔴 High Impairment Risk (>80%)",
			    Rate > 0.60, "🟡 Elevated AuC (60-80%)",
			    "🟢 Normal (<60%)"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: fd78a71c-b3ea-4b45-b5e5-d3c3defcfbac

	measure 'AuC Capitalization Color RAG' =
			VAR Rate = [Capitalization Rate %]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( Rate ), BLANK (),
			    Rate > 0.80, "#BE123C",
			    Rate > 0.60, "#D97706",
			    "#15803D"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: c9c95415-c63c-4960-b588-99eab9681843

	measure 'Overall Project Health RAG' =
			VAR CPI = [Cost Performance Index (CPI)]
			VAR SPI = [Schedule Performance Index (SPI)]
			VAR OpenPO = [PO Open Commitment NOK]
			RETURN
			SWITCH (
			    TRUE (),
			    CPI < 0.80 || OpenPO > 25000000, "🔴 CRITICAL OVERRUN (CPI: " & FORMAT ( CPI, "0.00" ) & " | Open PO: " & FORMAT ( OpenPO / 1e6, "0.0" ) & "M NOK)",
			    CPI < 0.95 || SPI < 0.95, "🟡 CAUTION (CPI: " & FORMAT ( CPI, "0.00" ) & " | SPI: " & FORMAT ( SPI, "0.00" ) & ")",
			    "🟢 ON TRACK (CPI: " & FORMAT ( CPI, "0.00" ) & " | SPI: " & FORMAT ( SPI, "0.00" ) & ")"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: e2d6ef16-28f9-438b-a1f8-9173ec03a442

	measure 'Overall Project Health Color RAG' =
			VAR CPI = [Cost Performance Index (CPI)]
			VAR OpenPO = [PO Open Commitment NOK]
			RETURN
			IF ( CPI < 0.80 || OpenPO > 25000000, "#BE123C", IF ( CPI < 0.95, "#D97706", "#15803D" ) )
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 4b04ee03-79c3-4aba-ba66-1b57760497fb

	measure 'Cost Variance Bar' =
			VAR Val = [Cost Variance (CV)]
			VAR MaxScale = 15000000
			VAR BarMaxLen = 12
			VAR Ratio = MIN ( 1.0, DIVIDE ( ABS ( Val ), MaxScale, 0 ) )
			VAR BarLen = MAX ( 1, ROUND ( Ratio * BarMaxLen, 0 ) )
			VAR BarStr = REPT ( "█", BarLen )
			RETURN
			IF (
			    ISBLANK ( Val ),
			    BLANK (),
			    IF ( Val >= 0, "🟩 " & BarStr & " (+" & FORMAT ( Val / 1e6, "0.0" ) & "M)", "🟥 " & BarStr & " (" & FORMAT ( Val / 1e6, "0.0" ) & "M)" )
			)
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: f84baccd-0dce-4af3-ae17-ffa5823cb43a

	measure 'Physical Progress Bar' =
			VAR Pct = [Physical Progress % (Current)]
			VAR BarMax = 10
			VAR Filled = MIN ( BarMax, MAX ( 0, ROUND ( Pct * BarMax, 0 ) ) )
			VAR Unfilled = BarMax - Filled
			RETURN
			IF ( ISBLANK ( Pct ), BLANK (), REPT ( "█", Filled ) & REPT ( "░", Unfilled ) & " " & FORMAT ( Pct, "0.0%" ) )
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: bf809736-34b2-4c18-aeb9-c38bf06bbb0e

	measure 'Activity Progress Bar' =
			VAR Pct = DIVIDE ( AVERAGE ( Dim_Activity[progress_pct] ), 100, 0 )
			VAR Filled = MIN ( 10, MAX ( 0, ROUND ( Pct * 10, 0 ) ) )
			VAR Unfilled = 10 - Filled
			VAR Icon = SWITCH ( TRUE (), Pct >= 1.0, "🟩 ", Pct > 0, "🟧 ", "🟥 " )
			RETURN
			IF ( ISBLANK ( Pct ), BLANK (), Icon & REPT ( "█", Filled ) & REPT ( "░", Unfilled ) & " " & FORMAT ( Pct, "0%" ) )
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: 02c3b21f-2673-49d7-85db-77fc88f72314

	measure 'Budget Consumption Bar' =
			VAR BAC = [Budget at Completion (BAC)]
			VAR AC = [Actual Cost (AC)]
			VAR Ratio = DIVIDE ( AC, BAC, 0 )
			VAR BarLen = MIN ( 15, MAX ( 1, ROUND ( Ratio * 4, 0 ) ) )
			RETURN
			IF (
			    ISBLANK ( Ratio ) || BAC = 0,
			    BLANK (),
			    IF ( Ratio > 1.0, "🟥 " & REPT ( "■", BarLen ) & " " & FORMAT ( Ratio, "0.0%" ), "🟩 " & REPT ( "■", BarLen ) & " " & FORMAT ( Ratio, "0.0%" ) )
			)
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: 4dfd9400-e2e3-48f0-afe8-8356ea694d2e

	measure 'PO Commitment Exposure Bar' =
			VAR OpenPO = [PO Open Commitment NOK]
			VAR TotalPO = [PO Amount NOK]
			VAR Rate = DIVIDE ( OpenPO, TotalPO, 0 )
			VAR Filled = MIN ( 10, MAX ( 0, ROUND ( Rate * 10, 0 ) ) )
			VAR Unfilled = 10 - Filled
			VAR Icon = SWITCH ( TRUE (), Rate >= 0.60, "🟥 ", Rate >= 0.35, "🟧 ", "🟩 " )
			RETURN
			IF ( ISBLANK ( OpenPO ) || TotalPO = 0, BLANK (), Icon & REPT ( "■", Filled ) & REPT ( "□", Unfilled ) & " " & FORMAT ( Rate, "0.0%" ) )
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: fb0e5b0a-05fe-4d79-a18e-d2a2b1167a68

	measure 'AuC Capitalization Bar' =
			VAR Rate = [Capitalization Rate %]
			VAR Filled = MIN ( 10, MAX ( 0, ROUND ( Rate * 10, 0 ) ) )
			VAR Unfilled = 10 - Filled
			RETURN
			IF ( ISBLANK ( Rate ), BLANK (), "🟦 " & REPT ( "■", Filled ) & REPT ( "□", Unfilled ) & " " & FORMAT ( Rate, "0.0%" ) )
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: 74f05679-45df-4851-8ae5-91084c703c2e

	measure 'Change Order Status RAG' =
			VAR S = SELECTEDVALUE ( Fact_ChangeOrders[status] )
			RETURN
			SWITCH (
			    S,
			    "IMPLEMENTED", "🟢 Implemented",
			    "APPROVED", "🟢 Approved",
			    "SUBMITTED", "🟡 Pending Approval",
			    "REJECTED", "🔴 Rejected",
			    IF ( ISBLANK ( COUNTROWS ( Fact_ChangeOrders ) ), BLANK (), "⚪ Total (" & FORMAT ( COUNTROWS ( Fact_ChangeOrders ), "0" ) & " COs)" )
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445501

	measure 'Change Order Status Color RAG' =
			VAR S = SELECTEDVALUE ( Fact_ChangeOrders[status] )
			RETURN
			SWITCH (
			    S,
			    "IMPLEMENTED", "#15803D",
			    "APPROVED", "#15803D",
			    "SUBMITTED", "#D97706",
			    "REJECTED", "#BE123C",
			    "#334155"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445502

	measure 'Change Order Exposure Bar' =
			VAR Req = SUM ( Fact_ChangeOrders[requested_amount_nok] )
			VAR S = SELECTEDVALUE ( Fact_ChangeOrders[status] )
			VAR MaxReq = IF ( ISINSCOPE ( Fact_ChangeOrders[change_order_id] ), 350000, 4000000 )
			VAR Ratio = MIN ( 1.0, DIVIDE ( Req, MaxReq, 0 ) )
			VAR Filled = MIN ( 10, MAX ( 1, ROUND ( Ratio * 10, 0 ) ) )
			VAR Unfilled = 10 - Filled
			VAR Prefix = SWITCH ( S, "IMPLEMENTED", "🟩 ", "APPROVED", "🟩 ", "SUBMITTED", "🟧 ", "REJECTED", "🟥 ", "🟦 " )
			RETURN
			IF ( ISBLANK ( Req ), BLANK (), Prefix & REPT ( "█", Filled ) & REPT ( "░", Unfilled ) & " " & FORMAT ( Req / 1e3, "#,0" ) & "k" )
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445503

	measure 'Activity Status RAG' =
			VAR S = SELECTEDVALUE ( Dim_Activity[status] )
			VAR Pct = DIVIDE ( AVERAGE ( Dim_Activity[progress_pct] ), 100, 0 )
			RETURN
			SWITCH (
			    S,
			    "Completed", "🟢 Completed (100%)",
			    "In Progress", "🟡 In Progress (" & FORMAT ( Pct, "0%" ) & ")",
			    "Not Started", "🔴 Not Started (0%)",
			    IF ( ISBLANK ( Pct ), BLANK (), "🔵 Avg (" & FORMAT ( Pct, "0.0%" ) & ")" )
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445504

	measure 'Activity Status Color RAG' =
			VAR S = SELECTEDVALUE ( Dim_Activity[status] )
			RETURN
			SWITCH (
			    S,
			    "Completed", "#15803D",
			    "In Progress", "#D97706",
			    "Not Started", "#BE123C",
			    "#15803D"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445505

	/// Paid supplier invoices (Net +30 days payment terms)
	measure 'Supplier AP Paid NOK' =
			SUMX (
			    VALUES ( Dim_Date[Month] ),
			    SWITCH (
			        Dim_Date[Month],
			        1, 0.0,
			        2, 2338988.89,
			        3, 4703852.59,
			        4, 3023329.04,
			        5, 6072390.05,
			        6, 3391872.92,
			        7, 1704668.46,
			        8, 5553634.93,
			        9, 8301329.99,
			        10, 7257303.41,
			        0.0
			    )
			)
		formatString: #,0
		displayFolder: 11 LIKVIDITET & KONTANTSTRØM
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445506

	/// Same-month payroll outflow for Elkem Fiskå internal engineering hours
	measure 'Internal Payroll Paid NOK' = SUM ( Fact_Timesheets[hours] ) * 530.0
		formatString: #,0
		displayFolder: 11 LIKVIDITET & KONTANTSTRØM
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445507

	/// Total monthly cash outflow (AP paid + Payroll paid)
	measure 'Total Cash Outflow NOK' = [Supplier AP Paid NOK] + [Internal Payroll Paid NOK]
		formatString: #,0
		displayFolder: 11 LIKVIDITET & KONTANTSTRØM
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445508

	/// Enova grant cash inflow upon milestone drawdown
	measure 'Enova Grant Cash In NOK' =
			SUMX (
			    VALUES ( Dim_Date[Month] ),
			    IF ( Dim_Date[Month] = 6, 3000000.0, 0.0 )
			)
		formatString: #,0
		displayFolder: 11 LIKVIDITET & KONTANTSTRØM
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445509

	/// Monthly net cash flow (Enova grant inflow minus total cash outflow)
	measure 'Net Monthly Cash Flow NOK' = [Enova Grant Cash In NOK] - [Total Cash Outflow NOK]
		formatString: #,0
		displayFolder: 11 LIKVIDITET & KONTANTSTRØM
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445510

	/// Cumulative net liquidity curve across project lifetime
	measure 'Cumulative Net Cash Flow NOK' =
			VAR MaxD = MAX ( Dim_Date[Date] )
			RETURN
			IF (
			    MaxD > DATE ( 2026, 10, 31 ) && ISINSCOPE ( Dim_Date[Month] ),
			    BLANK (),
			    CALCULATE (
			        [Net Monthly Cash Flow NOK],
			        FILTER ( ALLSELECTED ( Dim_Date ), Dim_Date[Date] <= MaxD )
			    )
			)
		formatString: #,0
		displayFolder: 11 LIKVIDITET & KONTANTSTRØM
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445511

	/// Elkem Fiskå Cost Center Code (CC-4100, CC-4200, CC-4300)
	measure 'Koststed Kode (Fiskå)' =
			SWITCH (
			    SELECTEDVALUE ( Dim_Employee[department] ),
			    "Operations", "CC-4100",
			    "R&D", "CC-4200",
			    "Finance", "CC-4300",
			    "CC-4100..4300"
			)
		displayFolder: 12 KOSTSTEDER FISKÅ
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445520

	/// Elkem Fiskå Cost Center Name & Location
	measure 'Koststed Navn (Fiskå)' =
			SWITCH (
			    SELECTEDVALUE ( Dim_Employee[department] ),
			    "Operations", "CC-4100: Pilotanlegg Drift & Mekanisk Verksted (Fiskå Bygg 12)",
			    "R&D", "CC-4200: FoU Sentrallab & Kjemisk Analyse (Fiskå Bygg 04)",
			    "Finance", "CC-4300: Prosessmetallurgi & Prosjektledelse (Fiskå Adm)",
			    "Alle Koststeder — Elkem Fiskå"
			)
		displayFolder: 12 KOSTSTEDER FISKÅ
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445521

	/// Logged internal hours by Elkem Fiskå cost center
	measure 'Faktiske Timer Koststed' = SUM ( Fact_Timesheets[hours] )
		formatString: #,0.0
		displayFolder: 12 KOSTSTEDER FISKÅ
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445512

	/// Internal engineering payroll cost by Elkem Fiskå cost center (530 NOK/hr)
	measure 'Personalkostnad Koststed NOK' = [Faktiske Timer Koststed] * 530.0
		formatString: #,0
		displayFolder: 12 KOSTSTEDER FISKÅ
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445513

	/// Share of total logged hours by Elkem Fiskå cost center
	measure 'Andel Timer Koststed %' =
			DIVIDE (
			    [Faktiske Timer Koststed],
			    CALCULATE ( [Faktiske Timer Koststed], ALL ( Dim_Employee ) ),
			    0
			)
		formatString: 0.0%
		displayFolder: 12 KOSTSTEDER FISKÅ
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445514

	/// Conditional Unicode bar length showing share of hours per Elkem Fiskå cost center
	measure 'Koststed Timer Bar' =
			VAR Hrs = [Faktiske Timer Koststed]
			VAR Share = [Andel Timer Koststed %]
			VAR Filled = MIN ( 10, MAX ( 1, ROUND ( Share * 20, 0 ) ) )
			VAR Unfilled = 10 - Filled
			RETURN
			IF (
			    ISBLANK ( Hrs ) || Hrs = 0,
			    BLANK (),
			    "🟦 " & REPT ( "█", Filled ) & REPT ( "░", Unfilled ) & " " & FORMAT ( Share, "0.0%" )
			)
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445515

	/// Monthly Early Warning RAG status badge
	measure 'Early Warning Status RAG' =
			VAR M = SELECTEDVALUE ( Dim_Date[Month] )
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( M ), "🔴 RED: PO > 100% BAC — CRITICAL",
			    M <= 2, "🟡 YELLOW: Burn-rate > 1.5x — WARNING",
			    M <= 10, "🔴 RED: PO > 100% BAC — CRITICAL",
			    BLANK ()
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445516

	/// Monthly Early Warning RAG hex color for conditional font formatting
	measure 'Early Warning Color RAG' =
			VAR M = SELECTEDVALUE ( Dim_Date[Month] )
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( M ), "#BE123C",
			    M <= 2, "#D97706",
			    M <= 10, "#BE123C",
			    "#15803D"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445517

	/// Conditional bar length for cumulative PO commitment vs BAC ratio in Early Warning log
	measure 'Early Warning PO Exposure Bar' =
			VAR M = SELECTEDVALUE ( Dim_Date[Month] )
			VAR Ratio =
			    SWITCH (
			        M,
			        1, 0.504,
			        2, 0.767,
			        3, 1.489,
			        4, 1.755,
			        5, 2.049,
			        6, 2.663,
			        7, 3.300,
			        8, 3.673,
			        9, 4.593,
			        10, 5.309,
			        IF ( ISBLANK ( M ), 5.309, BLANK () )
			    )
			VAR Clamped = MIN ( 1.0, MAX ( 0.0, DIVIDE ( Ratio, 5.5, 0 ) ) )
			VAR Filled = MIN ( 10, MAX ( 1, ROUND ( Clamped * 10, 0 ) ) )
			VAR Unfilled = 10 - Filled
			VAR Prefix = IF ( Ratio > 1.0, "🟥 ", "🟧 " )
			RETURN
			IF (
			    ISBLANK ( Ratio ),
			    BLANK (),
			    Prefix & REPT ( "█", Filled ) & REPT ( "░", Unfilled ) & " " & FORMAT ( Ratio * 100, "0.0" ) & "% BAC"
			)
		displayFolder: 10 BETINGET STOLPELENGDE
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445518

	/// Monthly Early Warning required controller action
	measure 'Early Warning Controller Action' =
			VAR M = SELECTEDVALUE ( Dim_Date[Month] )
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( M ), "Krav om Stage-Gate Freeze og formell styrebehandlet OTB.",
			    M <= 2, "Avstemming av åpne PO-er og de-scoping av lab-tester.",
			    M <= 10, "Krav om Stage-Gate Freeze og formell styrebehandlet OTB.",
			    BLANK ()
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 9f173c8b-1e4a-4b92-8e1a-112233445519

	/// Kombinert helseindikator (CPI * SPI). Under 0.90 = akutt alarm.
	measure 'Critical Ratio (CR)' = [Cost Performance Index (CPI)] * [Schedule Performance Index (SPI)]
		formatString: 0.000
		displayFolder: 02 Variances & Indices
		lineageTag: 55bd6400-fb0b-5a83-8626-363473073ac6

	/// Statistisk sluttkostnad basert på historisk kostnadseffektivitet (BAC / CPI).
	measure 'Estimate at Completion (EAC CPI)' = DIVIDE([Budget at Completion (BAC)], [Cost Performance Index (CPI)], [Budget at Completion (BAC)])
		formatString: #,##0.00
		displayFolder: 03 Forecasting
		lineageTag: 23c7420d-f272-54d6-acbb-a44d1d2c73a6

	/// Gjenstående kapitalbehov for å fullføre prosjektet (EAC - AC).
	measure 'Estimate to Complete (ETC)' = MAX(0, [Estimate at Completion (EAC CPI)] - [Actual Cost (AC)])
		formatString: #,##0.00
		displayFolder: 03 Forecasting
		lineageTag: 40faf317-37aa-503a-bced-a5f874f035e6

	/// Nødvendig effektivitet på gjenstående arbeid for å nå opprinnelig BAC (Urealistisk hvis > 1.10).
	measure 'To-Complete Performance Index (TCPI BAC)' = DIVIDE([Budget at Completion (BAC)] - [Earned Value (EV)], [Budget at Completion (BAC)] - [Actual Cost (AC)], 1.0)
		formatString: 0.00
		displayFolder: 03 Forecasting
		lineageTag: 28773702-ec42-5630-9b16-7d18055ed2b9

	/// Utviklingskostnader balanseført som Anlegg under utførelse (IAS 38 § 57, WBS-200 til 500).
	measure 'AuC Capitalized (Balance Sheet)' =
			CALCULATE(
			    SUM(Fact_GLActuals[amount_nok]),
			    Dim_WBS[ias38_treatment] = "CAPITALIZE"
			)
		formatString: #,##0.00
		displayFolder: 04 IFRS & Accounting
		lineageTag: d3681569-821c-515f-9f3a-665f7767b794

	/// Forsknings- og administrasjonskostnader driftsført direkte i resultat (IAS 38 § 54, WBS-100 og 600).
	measure 'P&L Expensed (Research & PMO)' =
			CALCULATE(
			    SUM(Fact_GLActuals[amount_nok]),
			    Dim_WBS[ias38_treatment] = "EXPENSE"
			)
		formatString: #,##0.00
		displayFolder: 04 IFRS & Accounting
		lineageTag: d0aa5cbd-c030-5b84-a62b-d4ec32568174

	/// Andel av faktiske kostnader som er aktivert i balansen som AuC.
	measure 'AuC Capitalization Ratio %' = DIVIDE([AuC Capitalized (Balance Sheet)], [Actual Cost (AC)], 0.0)
		formatString: 0.0%
		displayFolder: 04 IFRS & Accounting
		lineageTag: 83104016-c5d1-5475-a76a-5943bc8a0d9b

	/// Flagg som indikerer om formell verdifallstest kreves etter IAS 36 § 12 (utløst ved CPI < 0.50).
	measure 'IAS 36 Impairment Trigger Flag' =
			IF(
			    [Cost Performance Index (CPI)] < 0.50 && [AuC Capitalized (Balance Sheet)] > 20000000,
			    "🔴 TRIGGER: Formell IAS 36 Nedskrivningstest Påkrevd",
			    "🟢 OK: Ingen akutt verdifallstest utløst"
			)
		displayFolder: 04 IFRS & Accounting
		lineageTag: 591c7b2b-96e9-5584-9bd6-c803544ea10f

	/// Total verdi av godkjente og utstedte innkjøpsordrer i SAP ERP.
	measure 'PO Committed (Total)' = SUM(Fact_PurchaseOrders[amount_nok])
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		lineageTag: e6ede5ff-7b2a-58ae-a18f-d34e21e3e025

	/// Fakturert andel av innkjøpsordrer basert på inngående leverandørfakturaer.
	measure 'PO Invoiced (Total)' = SUM(Fact_PurchaseOrders[invoiced_nok])
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		lineageTag: f2f17775-e518-5008-ba78-9b9dcbc07b3c

	/// Åpne, uavsluttede innkjøpsforpliktelser (PO Committed - Invoiced). Likviditetsrisiko.
	measure 'Open Commitments (Total)' = SUM(Fact_PurchaseOrders[open_commitment_nok])
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		lineageTag: d56b2ee4-7549-596b-96de-459435f11b8d

	/// Total finansiell forpliktelse for Elkem: Bokført kostnad + Uavsluttede innkjøpsordrer.
	measure 'Total Financial Exposure' = [Actual Cost (AC)] + [Open Commitments (Total)]
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		lineageTag: d31c4e8e-cdbb-5866-8ae4-efd1c02e1add

	/// Forholdet mellom forpliktede innkjøp og totalbudsjett. Alarm hvis > 100%.
	measure 'PO vs BAC Ratio %' = DIVIDE([PO Committed (Total)], [Budget at Completion (BAC)], 0.0)
		formatString: 0.0%
		displayFolder: 05 Procurement & Commitments
		lineageTag: 15976f71-1f3a-514c-8462-d5d495ce4b7f

	/// Koststedets relative andel av de samlede faktiske prosjektkostnadene.
	measure 'Koststedsandel %' =
			DIVIDE(
			    [Faktiske Timer Koststed],
			    CALCULATE([Faktiske Timer Koststed], ALLSELECTED(Dim_Employee)),
			    0.0
			)
		formatString: 0.0%
		displayFolder: 07 Koststeder & Enheter
		lineageTag: 68cb8b03-0ec9-5a31-95fa-5f40043706ba

	/// Overordnet varselindikator basert på ledende forpliktelses- og effektivitetsgrenser.
	measure 'Early Warning Status Signal' =
			SWITCH(
			    TRUE(),
			    [PO vs BAC Ratio %] > 1.0, "🔴 KRITISK: Forpliktelser > 100% BAC (Innkjøpsfrys)",
			    [Cost Performance Index (CPI)] < 0.80, "🔴 RØD: Alvorlig kostnadsoverskridelse",
			    [Cost Performance Index (CPI)] < 0.90, "🟡 GUL: Kostnadspress / Marginavvik",
			    "🟢 GRØNN: Normal drift"
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: 0ca80b4b-07f1-5c51-a7d7-9379781440cc

	/// Hex-fargekode for betinget formatering av tabeller og KPI-kort.
	measure 'Early Warning Color Hex' =
			SWITCH(
			    TRUE(),
			    [PO vs BAC Ratio %] > 1.0, "#D32F2F",
			    [Cost Performance Index (CPI)] < 0.80, "#E53935",
			    [Cost Performance Index (CPI)] < 0.90, "#FB8C00",
			    "#43A047"
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: 57f5da9b-c52d-548b-a05f-4e76cd9dab7b

	/// Fargekode for CPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
	measure 'CPI RAG Color' =
			VAR Val = [Cost Performance Index (CPI)]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Val), "#737373",
			    Val < 0.90, "#D32F2F",
			    Val < 1.00, "#FB8C00",
			    "#43A047"
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: ca931543-4137-5d46-8e5e-2982ce5c3d2a

	/// Fargekode for SPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
	measure 'SPI RAG Color' =
			VAR Val = [Schedule Performance Index (SPI)]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Val), "#737373",
			    Val < 0.90, "#D32F2F",
			    Val < 1.00, "#FB8C00",
			    "#43A047"
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: b275263b-147c-5a9b-aef8-c64027036bcd

	/// Overordnet statusflagg for Executive Narrative
	measure 'Executive RAG Headline' =
			VAR _cpi = [Cost Performance Index (CPI)]
			VAR _exp = [Total Financial Exposure]
			VAR _bac = [Budget at Completion (BAC)]
			RETURN
			IF (
			    _cpi < 0.50 || _exp > _bac,
			    "🔴 RØD ALARM: KRITISK KOSTNADSSPREKK & LIKVIDITETSEKSPONERING (Per 31.10.2026)",
			    IF (
			        _cpi < 0.80 || _exp > _bac * 0.8,
			        "🟡 GULT VARSEL: BETYDELIG KOSTNADSPRESS & OPPFØLGINGSBEHOV",
			        "🟢 GRØNT LYS: PROSJEKTET LEVERER INNENFOR VEDTATT BUDSJETTRAMME"
			    )
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0001-4000-8000-000000000001

	/// Executive Narrative Del 1: EVM Diagnose
	measure 'Narrative Part1 Diagnose' =
			VAR _cpi = [Cost Performance Index (CPI)]
			VAR _cv = [Cost Variance (CV)] / 1000000
			VAR _spi = [Schedule Performance Index (SPI)]
			RETURN
			"1. DIAGNOSE (EVM): Prosjektet opererer med en kostnadseffektivitet på CPI "
			& FORMAT ( _cpi, "0.000" )
			& " og et akkumulert kostnadsavvik på NOK "
			& FORMAT ( _cv, "0.0" )
			& "M. Fysisk fremdrift meldes til SPI "
			& FORMAT ( _spi, "0.000" )
			& " som følge av forsert reaktormontasje."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0002-4000-8000-000000000002

	/// Executive Narrative Del 2: Hoveddriver & Likviditet
	measure 'Narrative Part2 Driver' =
			VAR _ac = [Actual Cost (AC)] / 1000000
			VAR _po = [PO Open Commitment NOK] / 1000000
			VAR _exp = [Total Financial Exposure] / 1000000
			VAR _ratio = DIVIDE ( [Total Financial Exposure], [Budget at Completion (BAC)], 0 )
			RETURN
			"2. DRIVER & LIKVIDITET: Bokførte kostnader (NOK "
			& FORMAT ( _ac, "0.0" )
			& "M) og åpne leverandørforpliktelser (NOK "
			& FORMAT ( _po, "0.0" )
			& "M) gir en samlet finansiell eksponering på NOK "
			& FORMAT ( _exp, "0.0" )
			& "M ("
			& FORMAT ( _ratio, "0%" )
			& " av godkjent totalbudsjett)."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0003-4000-8000-000000000003

	/// Executive Narrative Del 3: Regnskapsmessig Konsekvens (IAS 38 / IAS 36)
	measure 'Narrative Part3 Accounting' =
			VAR _auc = [Capitalized AuC NOK] / 1000000
			RETURN
			"3. REGNSKAPSMESSIG KONSEKVENS: Av de bokførte kostnadene er NOK "
			& FORMAT ( _auc, "0.0" )
			& "M balanseført som anlegg under utførelse (AuC) etter IAS 38. Eksploderende sluttkostnad (EAC) utløser umiddelbart krav om nedskrivningstest etter IAS 36 før årsoppgjøret."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0004-4000-8000-000000000004

	/// Executive Narrative Del 4: Påbud til Styret
	measure 'Narrative Part4 Action' =
			VAR _exp = [Total Financial Exposure]
			VAR _bac = [Budget at Completion (BAC)]
			RETURN
			IF (
			    _exp > _bac,
			    "4. PÅBUD TIL STYRET: 1) Umiddelbar innkjøpsfrys på alle nye rekvisisjoner. 2) Kanselleringsaudit av uleverte innkjøpsordrer (NOK 49,2M). 3) Innkall styret til ekstraordinært Stage-Gate møte for 30 dagers Technical Hold / Off-Ramp vurdering.",
			    "4. ANBEFALING: Fortsett månedlig kostnadsavstemming og tett oppfølging av leverandørfakturaer."
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0005-4000-8000-000000000005

	/// Side 2 Narrativ: S-Kurve Vurdering
	measure 'Page02_SCurve_Narrative' =
			VAR _cpi = [Cost Performance Index (CPI)]
			VAR _spi = [Schedule Performance Index (SPI)]
			VAR _sv = [Schedule Variance (SV)] / 1000000
			RETURN
			"S-KURVE ANALYSE: Prosjektet viser en klassisk overforsering. Fysisk fremdrift (EV 19,2M) ligger foran opprinnelig planlagt tid (SV: +"
			& FORMAT ( _sv, "0.0" ) & " MNOK / SPI: " & FORMAT ( _spi, "0.000" )
			& "), men enhetskostnaden er ekstremt ineffektiv (CPI: " & FORMAT ( _cpi, "0.000" ) & "). "
			& "Dette indikerer at forseringen er kjøpt gjennom massiv overtidsbruk og fordyrende hasteinnkjøp."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0006-4000-8000-000000000006

	/// Side 4 Narrativ: IFRS IAS 38 / 36 Vurdering
	measure 'Page03_IFRS_Narrative' =
			VAR _auc = [Capitalized AuC NOK] / 1000000
			VAR _fou = [Expensed R&D / OpEx NOK] / 1000000
			RETURN
			"IFRS IAS 38/36 ANALYSE: Av påløpte kostnader er NOK " & FORMAT ( _auc, "0.0" ) & "M aktivert som anlegg under utførelse (AuC) og NOK "
			& FORMAT ( _fou, "0.0" ) & "M driftsført over resultat. Eksploderende sluttkostnad utløser akutt krav om nedskrivningstest etter IAS 36 før årsoppgjøret."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0007-4000-8000-000000000007

	/// Side 6 Narrativ: Likviditetsvarsel & Arbeidskapital
	measure 'Page04_CashFlow_Narrative' =
			VAR _netCash = [Cumulative Net Cash Flow NOK] / 1000000
			VAR _po = [PO Open Commitment NOK] / 1000000
			RETURN
			"LIKVIDITETSVARSEL: Akkumulert netto likviditetsbelastning har nådd NOK " & FORMAT ( _netCash, "0.0" )
			& "M. Med 30 dagers DPO og åpne ordreforpliktelser på NOK " & FORMAT ( _po, "0.0" )
			& "M vil likviditetsgapet eskalere ytterligere før eventuelle nye Enova-refusjoner tilfaller."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0008-4000-8000-000000000008

	/// Side 5 Narrativ: AI Insights & Rotårsaksanalyse
	measure 'Page05_AI_Insights_Narrative' =
			"AI INSIGHTS & ROTÅRSAKSANALYSE: Nedbrytingstreet og variansmotoren identifiserer WBS 1.3 (Pilot Furnace Construction & Procurement) og valutabundne utstyrsleveranser som de dominerende driverne for kostnadssprekk og rød status."
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0009-4000-8000-000000000009

	/// Dynamisk markørfarge for S-kurve
	measure 'EVM_Marker_Color' =
			VAR _cpi = [Cost Performance Index (CPI)]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( _cpi ), "#737373",
			    _cpi < 0.50, "#C00000",
			    _cpi < 0.90, "#E69F00",
			    "#009E73"
			)
		displayFolder: 08 Early Warnings & RAG
		lineageTag: da990001-0010-4000-8000-000000000010

	column Value
		isHidden
		lineageTag: 81b0148e-e3ef-41c5-a937-ca34a2fb4b1f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ({"dummy"})

	annotation PBI_Id = 10ea645720ec4208b1cffb888a40c6d1

