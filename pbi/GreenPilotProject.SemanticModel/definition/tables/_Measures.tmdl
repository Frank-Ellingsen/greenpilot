	measure 'CV Status RAG' =
			VAR V = [Cost Variance (CV)]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( V ), BLANK (),
			    V >= 0, "🟢 On Budget (+" & FORMAT ( V / 1e6, "0.00" ) & "M)",
			    V >= -1000000, "🟡 Minor Overrun (" & FORMAT ( V / 1e6, "0.00" ) & "M)",
			    "🔴 Critical Overrun (" & FORMAT ( V / 1e6, "0.00" ) & "M)"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
