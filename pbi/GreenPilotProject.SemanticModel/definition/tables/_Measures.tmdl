table _Measures
	lineageTag: a7e39958-8686-4fbf-93ba-f27eb66b5930

	measure 'Budget at Completion (BAC)' =
		CALCULATE(SUM(Fact_BudgetBaseline[baseline_budget_nok]))
		formatString: #,##0.00
		displayFolder: 01 Core EVM
		description: Total godkjent baseline budsjettramme for GreenPilot 2026 (NOK 20.0M).
		lineageTag: 7734000860113684475

	measure 'Planned Value (PV)' =
		VAR MaxDate = MAX(Dim_Date[Date])
		RETURN
		CALCULATE(
		    SUM(Fact_BudgetBaseline[baseline_budget_nok]),
		    FILTER(
		        ALL(Dim_Date),
		        Dim_Date[Date] <= MaxDate
		    )
		)
		formatString: #,##0.00
		displayFolder: 01 Core EVM
		description: Planlagt verdi (BCWS) akkumulert frem til valgt periode basert på baseline.
		lineageTag: 8500438508629338778

	measure 'Actual Cost (AC)' =
		VAR StatusDate = MAX(Dim_Project[data_date])
		VAR MaxDate = MAX(Dim_Date[Date])
		RETURN
		IF(
		    MaxDate <= StatusDate || ISBLANK(MaxDate),
		    CALCULATE(
		        SUM(Fact_GLActuals[amount_nok]),
		        FILTER(ALL(Dim_Date), Dim_Date[Date] <= MaxDate)
		    ),
		    BLANK()
		)
		formatString: #,##0.00
		displayFolder: 01 Core EVM
		description: Faktisk bokførte kostnader (ACWP) i SAP ERP hovedbok frem til Data Date (31.10.2026).
		lineageTag: 5190781646456255324

	measure 'Earned Value (EV)' =
		VAR StatusDate = MAX(Dim_Project[data_date])
		VAR MaxDate = MAX(Dim_Date[Date])
		VAR TotalWeight = COUNTROWS(ALL(Dim_Activity))
		VAR CompletedWeight = CALCULATE(
		    COUNTROWS(Dim_Activity),
		    FILTER(
		        ALL(Dim_Activity),
		        Dim_Activity[status] = "Completed" &&
		        Dim_Activity[planned_finish] <= MaxDate
		    )
		)
		RETURN
		IF(
		    MaxDate <= StatusDate || ISBLANK(MaxDate),
		    DIVIDE(CompletedWeight, TotalWeight, 0) * [Budget at Completion (BAC)],
		    BLANK()
		)
		formatString: #,##0.00
		displayFolder: 01 Core EVM
		description: Opptjent verdi (BCWP) beregnet ut fra fysisk ferdiggrad i Primavera P6 ganget med BAC.
		lineageTag: 1216018221261104684

	measure 'Cost Variance (CV)' =
		[Earned Value (EV)] - [Actual Cost (AC)]
		formatString: #,##0.00
		displayFolder: 02 Variances & Indices
		description: Kostnadsavvik i NOK (EV - AC). Negativ verdi = overskridelse.
		lineageTag: 2386106979605474468

	measure 'Schedule Variance (SV)' =
		[Earned Value (EV)] - [Planned Value (PV)]
		formatString: #,##0.00
		displayFolder: 02 Variances & Indices
		description: Tidsavvik uttrykt i NOK (EV - PV). Negativ verdi = forsinkelse.
		lineageTag: 6218881817231526794

	measure 'Cost Performance Index (CPI)' =
		DIVIDE([Earned Value (EV)], [Actual Cost (AC)], 1.0)
		formatString: 0.000
		displayFolder: 02 Variances & Indices
		description: Kostnadseffektivitetsindeks (EV / AC). Under 1.00 = overbudsjett.
		lineageTag: 824218611232528185

	measure 'Schedule Performance Index (SPI)' =
		DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1.0)
		formatString: 0.000
		displayFolder: 02 Variances & Indices
		description: Fremdriftsindeks (EV / PV). Under 1.00 = bak tidsplan.
		lineageTag: 6752141415315172060

	measure 'Critical Ratio (CR)' =
		[Cost Performance Index (CPI)] * [Schedule Performance Index (SPI)]
		formatString: 0.000
		displayFolder: 02 Variances & Indices
		description: Kombinert helseindikator (CPI * SPI). Under 0.90 = akutt alarm.
		lineageTag: 2885054611201651336

	measure 'Estimate at Completion (EAC CPI)' =
		DIVIDE([Budget at Completion (BAC)], [Cost Performance Index (CPI)], [Budget at Completion (BAC)])
		formatString: #,##0.00
		displayFolder: 03 Forecasting
		description: Statistisk sluttkostnad basert på historisk kostnadseffektivitet (BAC / CPI).
		lineageTag: 6716038945395196477

	measure 'Estimate to Complete (ETC)' =
		MAX(0, [Estimate at Completion (EAC CPI)] - [Actual Cost (AC)])
		formatString: #,##0.00
		displayFolder: 03 Forecasting
		description: Gjenstående kapitalbehov for å fullføre prosjektet (EAC - AC).
		lineageTag: 5581487578755883596

	measure 'Variance at Completion (VAC)' =
		[Budget at Completion (BAC)] - [Estimate at Completion (EAC CPI)]
		formatString: #,##0.00
		displayFolder: 03 Forecasting
		description: Forventet budsjettavvik ved ferdigstillelse (BAC - EAC).
		lineageTag: 3942820119674663926

	measure 'To-Complete Performance Index (TCPI BAC)' =
		DIVIDE([Budget at Completion (BAC)] - [Earned Value (EV)], [Budget at Completion (BAC)] - [Actual Cost (AC)], 1.0)
		formatString: 0.00
		displayFolder: 03 Forecasting
		description: Nødvendig effektivitet på gjenstående arbeid for å nå opprinnelig BAC (Urealistisk hvis > 1.10).
		lineageTag: 4194185532021917159

	measure 'AuC Capitalized (Balance Sheet)' =
		CALCULATE(
		    SUM(Fact_GLActuals[amount_nok]),
		    Fact_GLActuals[ias38_treatment] = "CAPITALIZE"
		)
		formatString: #,##0.00
		displayFolder: 04 IFRS & Accounting
		description: Utviklingskostnader balanseført som Anlegg under utførelse (IAS 38 § 57, WBS-200 til 500).
		lineageTag: 6833853486802446828

	measure 'P&L Expensed (Research & PMO)' =
		CALCULATE(
		    SUM(Fact_GLActuals[amount_nok]),
		    Fact_GLActuals[ias38_treatment] = "EXPENSE"
		)
		formatString: #,##0.00
		displayFolder: 04 IFRS & Accounting
		description: Forsknings- og administrasjonskostnader driftsført direkte i resultat (IAS 38 § 54, WBS-100 og 600).
		lineageTag: 3916115144686256517

	measure 'AuC Capitalization Ratio %' =
		DIVIDE([AuC Capitalized (Balance Sheet)], [Actual Cost (AC)], 0.0)
		formatString: 0.0%
		displayFolder: 04 IFRS & Accounting
		description: Andel av faktiske kostnader som er aktivert i balansen som AuC.
		lineageTag: 3997559176271821028

	measure 'IAS 36 Impairment Trigger Flag' =
		IF(
		    [Cost Performance Index (CPI)] < 0.50 && [AuC Capitalized (Balance Sheet)] > 20000000,
		    "🔴 TRIGGER: Formell IAS 36 Nedskrivningstest Påkrevd",
		    "🟢 OK: Ingen akutt verdifallstest utløst"
		)
		formatString: @
		displayFolder: 04 IFRS & Accounting
		description: Flagg som indikerer om formell verdifallstest kreves etter IAS 36 § 12 (utløst ved CPI < 0.50).
		lineageTag: 2788837504084879419

	measure 'PO Committed (Total)' =
		SUM(Fact_PurchaseOrders[amount_nok])
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		description: Total verdi av godkjente og utstedte innkjøpsordrer i SAP ERP.
		lineageTag: 6355061336434622017

	measure 'PO Invoiced (Total)' =
		SUM(Fact_PurchaseOrders[invoiced_nok])
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		description: Fakturert andel av innkjøpsordrer basert på inngående leverandørfakturaer.
		lineageTag: 6857865523265390517

	measure 'Open Commitments (Total)' =
		SUM(Fact_PurchaseOrders[open_commitment_nok])
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		description: Åpne, uavsluttede innkjøpsforpliktelser (PO Committed - Invoiced). Likviditetsrisiko.
		lineageTag: 8543848659345311504

	measure 'Total Financial Exposure' =
		[Actual Cost (AC)] + [Open Commitments (Total)]
		formatString: #,##0.00
		displayFolder: 05 Procurement & Commitments
		description: Total finansiell forpliktelse for Elkem: Bokført kostnad + Uavsluttede innkjøpsordrer.
		lineageTag: 2100197653410409745

	measure 'PO vs BAC Ratio %' =
		DIVIDE([PO Committed (Total)], [Budget at Completion (BAC)], 0.0)
		formatString: 0.0%
		displayFolder: 05 Procurement & Commitments
		description: Forholdet mellom forpliktede innkjøp og totalbudsjett. Alarm hvis > 100%.
		lineageTag: 1775285738262590638

	measure 'Supplier AP Paid NOK' =
		SUM(Fact_CashFlowBridge[supplier_ap_paid_nok])
		formatString: #,##0.00
		displayFolder: 06 Cash Flow & Working Capital
		description: Faktiske utbetalinger til leverandører etter 30 dagers forfall (DPO).
		lineageTag: 518848028656688399

	measure 'Internal Payroll Paid NOK' =
		SUM(Fact_CashFlowBridge[internal_payroll_paid_nok])
		formatString: #,##0.00
		displayFolder: 06 Cash Flow & Working Capital
		description: Lønnsutbetalinger til egne ansatte på prosjektet.
		lineageTag: 2973748052837334673

	measure 'Total Cash Outflow NOK' =
		SUM(Fact_CashFlowBridge[total_cash_outflow_nok])
		formatString: #,##0.00
		displayFolder: 06 Cash Flow & Working Capital
		description: Samlet månedlig likviditetsbelastning for prosjektet (Leverandører + Lønn).
		lineageTag: 1461235138823348300

	measure 'Enova Grant Cash In NOK' =
		SUM(Fact_CashFlowBridge[enova_grant_cash_in_nok])
		formatString: #,##0.00
		displayFolder: 06 Cash Flow & Working Capital
		description: Innbetalte tilskuddsmidler fra Enova ved oppnådde milepæler.
		lineageTag: 5572401597693593246

	measure 'Net Monthly Cash Flow NOK' =
		[Enova Grant Cash In NOK] - [Total Cash Outflow NOK]
		formatString: #,##0.00
		displayFolder: 06 Cash Flow & Working Capital
		description: Månedlig netto kontantstrøm for Elkem (Tilskudd inn - Utbetalinger ut).
		lineageTag: 7739604353421477045

	measure 'Cumulative Net Cash Flow NOK' =
		VAR MaxDate = MAX(Dim_Date[Date])
		RETURN
		CALCULATE(
		    [Net Monthly Cash Flow NOK],
		    FILTER(
		        ALL(Dim_Date),
		        Dim_Date[Date] <= MaxDate
		    )
		)
		formatString: #,##0.00
		displayFolder: 06 Cash Flow & Working Capital
		description: Akkumulert kontantposisjon som viser Elkems maksimale kapitalbinding (Peak Working Capital Exposure).
		lineageTag: 8656063398157707745

	measure 'Faktiske Timer Koststed' =
		SUM(Fact_Timesheets[hours])
		formatString: #,##0.0
		displayFolder: 07 Koststeder & Enheter
		description: Totalt antall registrerte timer fra timelister for valgt koststed/avdeling.
		lineageTag: 1123764999304202613

	measure 'Personalkostnad Koststed NOK' =
		[Faktiske Timer Koststed] * 530.0
		formatString: #,##0.00
		displayFolder: 07 Koststeder & Enheter
		description: Beregnet personalkostnad for koststedet basert på SkatteFUNN-godkjent sats (maks 530 kr/t).
		lineageTag: 5693191482134641209

	measure 'Koststedsandel %' =
		DIVIDE(
		    [Actual Cost (AC)],
		    CALCULATE([Actual Cost (AC)], ALLSELECTED(Dim_CostCenter)),
		    0.0
		)
		formatString: 0.0%
		displayFolder: 07 Koststeder & Enheter
		description: Koststedets relative andel av de samlede faktiske prosjektkostnadene.
		lineageTag: 917700157147998323

	measure 'Early Warning Status Signal' =
		SWITCH(
		    TRUE(),
		    [PO vs BAC Ratio %] > 1.0, "🔴 KRITISK: Forpliktelser > 100% BAC (Innkjøpsfrys)",
		    [Cost Performance Index (CPI)] < 0.80, "🔴 RØD: Alvorlig kostnadsoverskridelse",
		    [Cost Performance Index (CPI)] < 0.90, "🟡 GUL: Kostnadspress / Marginavvik",
		    "🟢 GRØNN: Normal drift"
		)
		formatString: @
		displayFolder: 08 Early Warnings & RAG
		description: Overordnet varselindikator basert på ledende forpliktelses- og effektivitetsgrenser.
		lineageTag: 1665697515642283447

	measure 'Early Warning Color Hex' =
		SWITCH(
		    TRUE(),
		    [PO vs BAC Ratio %] > 1.0, "#D32F2F",   // Mørkerød
		    [Cost Performance Index (CPI)] < 0.80, "#E53935",   // Rød
		    [Cost Performance Index (CPI)] < 0.90, "#FB8C00",   // Oransje/Gul
		    "#43A047"                                           // Grønn
		)
		formatString: @
		displayFolder: 08 Early Warnings & RAG
		description: Hex-fargekode for betinget formatering av tabeller og KPI-kort.
		lineageTag: 3287851543390474168

	measure 'CPI RAG Color' =
		VAR Val = [Cost Performance Index (CPI)]
		RETURN
		SWITCH(
		    TRUE(),
		    ISBLANK(Val), "#737373",
		    Val < 0.90, "#D32F2F",
		    Val < 1.00, "#FB8C00",
		    "#43A047"
		)
		formatString: @
		displayFolder: 08 Early Warnings & RAG
		description: Fargekode for CPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
		lineageTag: 7856153931673516947

	measure 'SPI RAG Color' =
		VAR Val = [Schedule Performance Index (SPI)]
		RETURN
		SWITCH(
		    TRUE(),
		    ISBLANK(Val), "#737373",
		    Val < 0.90, "#D32F2F",
		    Val < 1.00, "#FB8C00",
		    "#43A047"
		)
		formatString: @
		displayFolder: 08 Early Warnings & RAG
		description: Fargekode for SPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
		lineageTag: 5206145584053128121

	measure 'CPI Status RAG' =
		VAR Val = [Cost Performance Index (CPI)]
		RETURN
		SWITCH(
		    TRUE(),
		    ISBLANK(Val), "⚪",
		    Val < 0.90, "🔴",
		    Val < 1.00, "🟡",
		    "🟢"
		)
		formatString: @
		displayFolder: 08 Early Warnings & RAG
		description: Dynamisk RAG-statusikon for CPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
		lineageTag: 6711191166060907210

	measure 'SPI Status RAG' =
		VAR Val = [Schedule Performance Index (SPI)]
		RETURN
		SWITCH(
		    TRUE(),
		    ISBLANK(Val), "⚪",
		    Val < 0.90, "🔴",
		    Val < 1.00, "🟡",
		    "🟢"
		)
		formatString: @
		displayFolder: 08 Early Warnings & RAG
		description: Dynamisk RAG-statusikon for SPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
		lineageTag: 683671138300874724
