	measure 'CPI Status RAG' =
			VAR V = [Cost Performance Index (CPI)]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( V ), BLANK (),
			    V >= 0.95, "🟢 Green (" & FORMAT ( V, "0.00" ) & ")",
			    V >= 0.85, "🟡 Amber (" & FORMAT ( V, "0.00" ) & ")",
			    "🔴 Red (" & FORMAT ( V, "0.00" ) & ")"
			)
		displayFolder: 09 DYNAMISK RAG FORMATERING
		lineageTag: 6115c72a-174d-4ee8-a8b4-36729bf674a2

	measure 'CPI Color RAG' =
