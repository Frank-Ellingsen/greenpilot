// ===============================================================================
// MASTER DAX MEASURES LIBRARY - ELKEM TECHNOLOGY (GREENPILOT 2026)
// ===============================================================================


// -------------------------------------------------------------------------------
// MAPPE: 01 Core EVM
// -------------------------------------------------------------------------------
// Beskrivelse: Total godkjent baseline budsjettramme for GreenPilot 2026 (NOK 20.0M).
// Format: #,##0.00
[Budget at Completion (BAC)] =
CALCULATE(SUM(Fact_BudgetBaseline[baseline_budget_nok]))

// Beskrivelse: Planlagt verdi (BCWS) akkumulert frem til valgt periode basert på baseline.
// Format: #,##0.00
[Planned Value (PV)] =
VAR MaxDate = MAX(Dim_Date[Date])
RETURN
CALCULATE(
    SUM(Fact_BudgetBaseline[baseline_budget_nok]),
    FILTER(
        ALL(Dim_Date),
        Dim_Date[Date] <= MaxDate
    )
)

// Beskrivelse: Faktisk bokførte kostnader (ACWP) i SAP ERP hovedbok frem til Data Date (31.10.2026).
// Format: #,##0.00
[Actual Cost (AC)] =
VAR StatusDate = MAX(Dim_Project[data_date])
VAR MaxDate = MAX(Dim_Date[Date])
RETURN
IF(
    MaxDate <= StatusDate || ISBLANK(MaxDate),
    CALCULATE(
        SUM(Fact_GLActuals[amount_nok]),
        FILTER(ALL(Dim_Date), Dim_Date[Date] <= MaxDate)
    ),
    BLANK()
)

// Beskrivelse: Opptjent verdi (BCWP) beregnet ut fra fysisk ferdiggrad i Primavera P6 ganget med BAC.
// Format: #,##0.00
[Earned Value (EV)] =
VAR StatusDate = MAX(Dim_Project[data_date])
VAR MaxDate = MAX(Dim_Date[Date])
VAR TotalWeight = COUNTROWS(ALL(Dim_Activity))
VAR CompletedWeight = CALCULATE(
    COUNTROWS(Dim_Activity),
    FILTER(
        ALL(Dim_Activity),
        Dim_Activity[status] = "Completed" &&
        Dim_Activity[planned_finish] <= MaxDate
    )
)
RETURN
IF(
    MaxDate <= StatusDate || ISBLANK(MaxDate),
    DIVIDE(CompletedWeight, TotalWeight, 0) * [Budget at Completion (BAC)],
    BLANK()
)


// -------------------------------------------------------------------------------
// MAPPE: 02 Variances & Indices
// -------------------------------------------------------------------------------
// Beskrivelse: Kostnadsavvik i NOK (EV - AC). Negativ verdi = overskridelse.
// Format: #,##0.00
[Cost Variance (CV)] =
[Earned Value (EV)] - [Actual Cost (AC)]

// Beskrivelse: Tidsavvik uttrykt i NOK (EV - PV). Negativ verdi = forsinkelse.
// Format: #,##0.00
[Schedule Variance (SV)] =
[Earned Value (EV)] - [Planned Value (PV)]

// Beskrivelse: Kostnadseffektivitetsindeks (EV / AC). Under 1.00 = overbudsjett.
// Format: 0.000
[Cost Performance Index (CPI)] =
DIVIDE([Earned Value (EV)], [Actual Cost (AC)], 1.0)

// Beskrivelse: Fremdriftsindeks (EV / PV). Under 1.00 = bak tidsplan.
// Format: 0.000
[Schedule Performance Index (SPI)] =
DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1.0)

// Beskrivelse: Kombinert helseindikator (CPI * SPI). Under 0.90 = akutt alarm.
// Format: 0.000
[Critical Ratio (CR)] =
[Cost Performance Index (CPI)] * [Schedule Performance Index (SPI)]


// -------------------------------------------------------------------------------
// MAPPE: 03 Forecasting
// -------------------------------------------------------------------------------
// Beskrivelse: Statistisk sluttkostnad basert på historisk kostnadseffektivitet (BAC / CPI).
// Format: #,##0.00
[Estimate at Completion (EAC CPI)] =
DIVIDE([Budget at Completion (BAC)], [Cost Performance Index (CPI)], [Budget at Completion (BAC)])

// Beskrivelse: Gjenstående kapitalbehov for å fullføre prosjektet (EAC - AC).
// Format: #,##0.00
[Estimate to Complete (ETC)] =
MAX(0, [Estimate at Completion (EAC CPI)] - [Actual Cost (AC)])

// Beskrivelse: Forventet budsjettavvik ved ferdigstillelse (BAC - EAC).
// Format: #,##0.00
[Variance at Completion (VAC)] =
[Budget at Completion (BAC)] - [Estimate at Completion (EAC CPI)]

// Beskrivelse: Nødvendig effektivitet på gjenstående arbeid for å nå opprinnelig BAC (Urealistisk hvis > 1.10).
// Format: 0.00
[To-Complete Performance Index (TCPI BAC)] =
DIVIDE([Budget at Completion (BAC)] - [Earned Value (EV)], [Budget at Completion (BAC)] - [Actual Cost (AC)], 1.0)


// -------------------------------------------------------------------------------
// MAPPE: 04 IFRS & Accounting
// -------------------------------------------------------------------------------
// Beskrivelse: Utviklingskostnader balanseført som Anlegg under utførelse (IAS 38 § 57, WBS-200 til 500).
// Format: #,##0.00
[AuC Capitalized (Balance Sheet)] =
CALCULATE(
    SUM(Fact_GLActuals[amount_nok]),
    Dim_WBS[ias38_treatment] = "CAPITALIZE"
)

// Beskrivelse: Forsknings- og administrasjonskostnader driftsført direkte i resultat (IAS 38 § 54, WBS-100 og 600).
// Format: #,##0.00
[P&L Expensed (Research & PMO)] =
CALCULATE(
    SUM(Fact_GLActuals[amount_nok]),
    Dim_WBS[ias38_treatment] = "EXPENSE"
)

// Beskrivelse: Andel av faktiske kostnader som er aktivert i balansen som AuC.
// Format: 0.0%
[AuC Capitalization Ratio %] =
DIVIDE([AuC Capitalized (Balance Sheet)], [Actual Cost (AC)], 0.0)

// Beskrivelse: Flagg som indikerer om formell verdifallstest kreves etter IAS 36 § 12 (utløst ved CPI < 0.50).
// Format: @
[IAS 36 Impairment Trigger Flag] =
IF(
    [Cost Performance Index (CPI)] < 0.50 && [AuC Capitalized (Balance Sheet)] > 20000000,
    "🔴 TRIGGER: Formell IAS 36 Nedskrivningstest Påkrevd",
    "🟢 OK: Ingen akutt verdifallstest utløst"
)


// -------------------------------------------------------------------------------
// MAPPE: 05 Procurement & Commitments
// -------------------------------------------------------------------------------
// Beskrivelse: Total verdi av godkjente og utstedte innkjøpsordrer i SAP ERP.
// Format: #,##0.00
[PO Committed (Total)] =
SUM(Fact_PurchaseOrders[amount_nok])

// Beskrivelse: Fakturert andel av innkjøpsordrer basert på inngående leverandørfakturaer.
// Format: #,##0.00
[PO Invoiced (Total)] =
SUM(Fact_PurchaseOrders[invoiced_nok])

// Beskrivelse: Åpne, uavsluttede innkjøpsforpliktelser (PO Committed - Invoiced). Likviditetsrisiko.
// Format: #,##0.00
[Open Commitments (Total)] =
SUM(Fact_PurchaseOrders[open_commitment_nok])

// Beskrivelse: Total finansiell forpliktelse for Elkem: Bokført kostnad + Uavsluttede innkjøpsordrer.
// Format: #,##0.00
[Total Financial Exposure] =
[Actual Cost (AC)] + [Open Commitments (Total)]

// Beskrivelse: Forholdet mellom forpliktede innkjøp og totalbudsjett. Alarm hvis > 100%.
// Format: 0.0%
[PO vs BAC Ratio %] =
DIVIDE([PO Committed (Total)], [Budget at Completion (BAC)], 0.0)


// -------------------------------------------------------------------------------
// MAPPE: 06 Cash Flow & Working Capital
// -------------------------------------------------------------------------------
// Beskrivelse: Faktiske utbetalinger til leverandører etter 30 dagers forfall (DPO).
// Format: #,##0.00
[Supplier AP Paid NOK] =
SUM(Fact_CashFlowBridge[supplier_ap_paid_nok])

// Beskrivelse: Lønnsutbetalinger til egne ansatte på prosjektet.
// Format: #,##0.00
[Internal Payroll Paid NOK] =
SUM(Fact_CashFlowBridge[internal_payroll_paid_nok])

// Beskrivelse: Samlet månedlig likviditetsbelastning for prosjektet (Leverandører + Lønn).
// Format: #,##0.00
[Total Cash Outflow NOK] =
SUM(Fact_CashFlowBridge[total_cash_outflow_nok])

// Beskrivelse: Innbetalte tilskuddsmidler fra Enova ved oppnådde milepæler.
// Format: #,##0.00
[Enova Grant Cash In NOK] =
SUM(Fact_CashFlowBridge[enova_grant_cash_in_nok])

// Beskrivelse: Månedlig netto kontantstrøm for Elkem (Tilskudd inn - Utbetalinger ut).
// Format: #,##0.00
[Net Monthly Cash Flow NOK] =
[Enova Grant Cash In NOK] - [Total Cash Outflow NOK]

// Beskrivelse: Akkumulert kontantposisjon som viser Elkems maksimale kapitalbinding (Peak Working Capital Exposure).
// Format: #,##0.00
[Cumulative Net Cash Flow NOK] =
VAR MaxDate = MAX(Dim_Date[Date])
RETURN
CALCULATE(
    [Net Monthly Cash Flow NOK],
    FILTER(
        ALL(Dim_Date),
        Dim_Date[Date] <= MaxDate
    )
)


// -------------------------------------------------------------------------------
// MAPPE: 07 Koststeder & Enheter
// -------------------------------------------------------------------------------
// Beskrivelse: Totalt antall registrerte timer fra timelister for valgt koststed/avdeling.
// Format: #,##0.0
[Faktiske Timer Koststed] =
SUM(Fact_Timesheets[hours])

// Beskrivelse: Beregnet personalkostnad for koststedet basert på SkatteFUNN-godkjent sats (maks 530 kr/t).
// Format: #,##0.00
[Personalkostnad Koststed NOK] =
[Faktiske Timer Koststed] * 530.0

// Beskrivelse: Koststedets relative andel av de samlede faktiske prosjektkostnadene.
// Format: 0.0%
[Koststedsandel %] =
DIVIDE(
    [Actual Cost (AC)],
    CALCULATE([Actual Cost (AC)], ALLSELECTED(Dim_CostCenter)),
    0.0
)


// -------------------------------------------------------------------------------
// MAPPE: 08 Early Warnings & RAG
// -------------------------------------------------------------------------------
// Beskrivelse: Overordnet varselindikator basert på ledende forpliktelses- og effektivitetsgrenser.
// Format: @
[Early Warning Status Signal] =
SWITCH(
    TRUE(),
    [PO vs BAC Ratio %] > 1.0, "🔴 KRITISK: Forpliktelser > 100% BAC (Innkjøpsfrys)",
    [Cost Performance Index (CPI)] < 0.80, "🔴 RØD: Alvorlig kostnadsoverskridelse",
    [Cost Performance Index (CPI)] < 0.90, "🟡 GUL: Kostnadspress / Marginavvik",
    "🟢 GRØNN: Normal drift"
)

// Beskrivelse: Hex-fargekode for betinget formatering av tabeller og KPI-kort.
// Format: @
[Early Warning Color Hex] =
SWITCH(
    TRUE(),
    [PO vs BAC Ratio %] > 1.0, "#D32F2F",
    [Cost Performance Index (CPI)] < 0.80, "#E53935",
    [Cost Performance Index (CPI)] < 0.90, "#FB8C00",
    "#43A047"
)

// Beskrivelse: Dynamisk RAG-statusikon for CPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
// Format: @
[CPI Status RAG] =
VAR Val = [Cost Performance Index (CPI)]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(Val), "⚪",
    Val < 0.90, "🔴",
    Val < 1.00, "🟡",
    "🟢"
)

// Beskrivelse: Dynamisk RAG-statusikon for SPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
// Format: @
[SPI Status RAG] =
VAR Val = [Schedule Performance Index (SPI)]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(Val), "⚪",
    Val < 0.90, "🔴",
    Val < 1.00, "🟡",
    "🟢"
)

// Beskrivelse: Fargekode for CPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
// Format: @
[CPI RAG Color] =
VAR Val = [Cost Performance Index (CPI)]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(Val), "#737373",
    Val < 0.90, "#D32F2F",
    Val < 1.00, "#FB8C00",
    "#43A047"
)

// Beskrivelse: Fargekode for SPI (Grønn >= 1.0, Gul 0.90-1.0, Rød < 0.90).
// Format: @
[SPI RAG Color] =
VAR Val = [Schedule Performance Index (SPI)]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(Val), "#737373",
    Val < 0.90, "#D32F2F",
    Val < 1.00, "#FB8C00",
    "#43A047"
)

